subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "westeurope"
app_name        = "myapp"

# Placeholder image — public, needs no registry credentials, so the template can
# be applied and verified before a real application image exists. Replace with
# your own image (and set container_registry_url) for a real deployment.
container_image        = "mcr.microsoft.com/azuredocs/aci-helloworld:latest"
container_registry_url = "mcr.microsoft.com"

# nginx-style placeholder images serve "/" but have no /health endpoint, so the
# App Service health check must point at "/" or instances are recycled on a
# probe that can never succeed. Switch back to "/health" for a real app.
health_check_path = "/"

# Real apps: 8080 (default). Placeholder: 80.
container_port = 80

app_settings = {
  ASPNETCORE_ENVIRONMENT = "Development"
}
